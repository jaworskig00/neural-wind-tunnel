{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    /* Unit tests run in Node and may read fixtures off disk. Keeping the Node globals in a project
       of their own is what stops `fs` and `Buffer` becoming reachable from browser code. */
    "types": ["vite/client", "node"],
    "composite": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  /* `exclude` is inherited from the app project, where it removes exactly these files. Without
     clearing it here the two cancel out and tsc reports no inputs at all. */
  "exclude": []
}
